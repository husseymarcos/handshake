<% content_for :title, "#{@opportunity.organization_name} — Handshake" %>

<div class="page-header row row--between">
  <div>
    <h1 class="display title--compact"><%= @opportunity.organization_name %></h1>
    <p class="muted">Adapted <%= l @opportunity.created_at, format: :long %></p>
    <% if @opportunity.posting_truncated? %>
      <p class="notice-card" role="alert">The posting was shortened to the token limit.</p>
    <% end %>
  </div>
  <% if @opportunity.pdf.attached? %>
    <%= link_to "Download Resume", opportunity_download_path(@opportunity), class: "pill pill--accent" %>
  <% end %>
</div>

<section class="card card--section">
  <h2 class="title title--section">Posting used</h2>
  <pre class="preview"><%= @opportunity.posting %></pre>
</section>

<% if @opportunity.generated_typst.present? %>
  <section class="card card--section">
    <h2 class="title title--section">Adapted Typst</h2>
    <pre class="preview"><%= @opportunity.generated_typst %></pre>
  </section>
<% end %>

<p><%= link_to "← History", opportunities_path, class: "link" %></p>
