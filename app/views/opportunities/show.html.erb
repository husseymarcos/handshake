<% content_for :title, "#{@opportunity.organization_name} — Handshake" %>

<div class="show-header">
  <div class="show-header__top">
    <%= link_to "← See previous opportunities", opportunities_path, class: "show-header__back" %>
    <% if @opportunity.pdf.attached? %>
      <%= link_to "Download PDF", opportunity_download_path(@opportunity), class: "btn btn--primary btn--small" %>
    <% end %>
  </div>

  <div class="show-header__info">
    <h1 class="show-header__title"><%= @opportunity.organization_name %></h1>
    <p class="show-header__meta">Adapted <%= l @opportunity.created_at, format: :long %></p>
  </div>
</div>

<% if @opportunity.pdf.attached? %>
  <div class="pdf-viewer">
    <iframe src="<%= rails_blob_path(@opportunity.pdf, disposition: :inline) %>" class="pdf-viewer__frame" title="Adapted resume for <%= @opportunity.organization_name %>"></iframe>
  </div>
<% end %>
