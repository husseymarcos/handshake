<div class="form-panel">
  <div class="form-panel__header">
    <div class="icon-box">
      <%= render "shared/icons/info" %>
    </div>
    <div class="form-panel__body">
      <div class="form-panel__title">What happens next?</div>
      <div class="form-panel__description">
        We read the job posting, then craft a resume that speaks directly to what they're looking for. In 30 seconds, you'll have a tailored PDF ready to send.
      </div>
    </div>
    <div class="media-thumb">
      <%= image_tag "writeonce.png", alt: "", class: "media-thumb__image" %>
    </div>
  </div>
</div>
