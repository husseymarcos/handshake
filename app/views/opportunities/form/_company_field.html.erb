<div class="form-panel">
  <div class="form-panel__header">
    <%= render "shared/icons/building" %>
    <div class="form-panel__body">
      <div class="form-panel__title">1. Company</div>
      <div class="form-panel__description">Who are you applying to?</div>
    </div>
  </div>

  <%= f.text_field :organization_name, placeholder: "e.g. Linear, Notion, Airbnb", class: "input" %>

  <div class="handwritten-note">
    <svg class="handwritten-note__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 19V5"/>
      <polyline points="5 12 12 5 19 12"/>
    </svg>
    <span>Add the company name to help us tailor the pitch and tone.</span>
  </div>
</div>
