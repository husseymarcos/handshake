<div class="form-panel">
  <div class="form-panel__header">
    <%= render "shared/icons/document" %>
    <div class="form-panel__body">
      <div class="form-panel__title">2. Job Description</div>
      <div class="form-panel__description">Paste the full job description.</div>
    </div>
  </div>

  <div class="auth-field__control">
    <%= f.text_area :posting, rows: 8, placeholder: "Paste the job description here...", class: "input home-textarea" %>
  </div>

  <div class="form-panel__footer">
    <button type="button" class="btn btn--secondary" data-action="click->opportunity-form#pasteFromClipboard">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
        <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
      </svg>
      Paste
    </button>
    <span class="meta" data-opportunity-form-target="counter">0 characters</span>
  </div>
</div>
