<% content_for :title, "Past Applications — Handshake" %>

<div class="history-page">
  <%= render "history_header" %>
  <%= render "history_search" %>

  <% if @opportunities.any? %>
    <%= render "history_table", opportunities: @opportunities %>
  <% else %>
    <%= render "history_empty" %>
  <% end %>

  <%= render "history_footer" %>
</div>
