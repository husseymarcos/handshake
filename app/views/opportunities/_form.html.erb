<%= form_with model: @opportunity, class: "stack", data: { controller: "opportunity-form" } do |f| %>
  <%= render 'opportunities/form/errors', opportunity: @opportunity %>

  <div class="form-grid">
    <%= render 'opportunities/form/company_field', f: f %>
    <%= render 'opportunities/form/job_description_field', f: f %>
    <%= render 'opportunities/form/tone_field', f: f %>
    <%= render 'opportunities/form/what_happens_next' %>
  </div>

  <%= render 'opportunities/form/submit_button' %>
  <%= render 'opportunities/form/privacy_note' %>
<% end %>
