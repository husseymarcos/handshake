<% content_for :title, "Past Opportunities — Handshake" %>

<div class="page-header row row--between">
  <div>
    <h1 class="display">Past Opportunities</h1>
    <p class="lede">Newest opportunities first.</p>
  </div>
  <%= link_to "New Opportunity", root_path, class: "pill pill--accent" %>
</div>

<% if @opportunities.any? %>
  <ul class="card list-plain stack">
    <% @opportunities.each do |opp| %>
      <li class="history-row">
        <div>
          <%= link_to opp.company_name, opportunity_path(opp), class: "history-row__title" %>
          <div class="muted"><%= l opp.created_at, format: :long %></div>
        </div>
        <% if opp.pdf.attached? %>
          <%= link_to "PDF", opportunity_download_path(opp), class: "pill" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="card">
    <p class="lede">No opportunities yet.</p>
    <%= link_to "Create your first", root_path, class: "pill pill--accent" %>
  </div>
<% end %>
