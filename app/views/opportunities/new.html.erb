<% content_for :title, "Apply — Handshake" %>

<div class="card">
  <%= form_with model: @opportunity, class: "stack" do |f| %>
    <% if @opportunity.errors.any? %>
      <div class="form-errors">
        <ul>
          <% @opportunity.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <label class="field__label field__label--large">Who are you applying to?</label>
      <%= f.text_field :company_name, required: true, class: "input input--display input--massive", placeholder: "Company Name" %>
    </div>

    <hr class="form-divider">

    <div class="field">
      <label class="field__label field__label--large">What do they want?</label>
      <%= f.text_area :job_description, required: true, rows: 12, class: "input input--display", placeholder: "Paste the job posting requirements here..." %>
    </div>

    <div class="form-actions">
      <%= button_tag type: :submit, class: "btn-adapt" do %>
        adapt
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      <% end %>
    </div>
  <% end %>
</div>
