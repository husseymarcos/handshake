<% content_for :title, "Adapt CV — Handshake" %>
<% @hide_nav = true %>

<div class="app-layout">
  <!-- Sidebar -->
  <aside class="app-layout__sidebar">
    <%= link_to root_path, class: "sidebar-logo" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 0 1 10 10c0 5.523-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2z"/>
        <path d="M8 12s1.5 2 4 2 4-2 4-2"/>
        <line x1="9" y1="9" x2="9.01" y2="9"/>
        <line x1="15" y1="9" x2="15.01" y2="9"/>
      </svg>
      Handshake
    <% end %>

    <nav class="sidebar-nav">
      <%= link_to new_opportunity_path,
          class: "sidebar-nav__item #{current_page?(new_opportunity_path) || current_page?(root_path) ? 'sidebar-nav__item--active' : ''}" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        Adapt CV
      <% end %>

      <%= link_to career_path,
          class: "sidebar-nav__item #{current_page?(career_path) ? 'sidebar-nav__item--active' : ''}" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
        Career Profile
      <% end %>

      <%= link_to opportunities_path,
          class: "sidebar-nav__item #{current_page?(opportunities_path) ? 'sidebar-nav__item--active' : ''}" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        Past Applications
      <% end %>

      <%= link_to "#", class: "sidebar-nav__item" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
        Blueprint Template
      <% end %>

      <%= link_to settings_path,
          class: "sidebar-nav__item #{current_page?(settings_path) ? 'sidebar-nav__item--active' : ''}" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
        Settings
      <% end %>
    </nav>

    <!-- Promo Card -->
    <div class="sidebar-promo">
      <svg class="sidebar-promo__star" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
      <p class="sidebar-promo__text">
        Write once.<br>
        <em>Apply everywhere.</em><br>
        Perfect resumes<br>
        in <em>one click.</em>
      </p>
    </div>

    <!-- Illustration Placeholder -->
    <div class="sidebar-illustration">
      <div class="sidebar-illustration__placeholder">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
          <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
          <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
          <line x1="6" y1="1" x2="6" y2="4"/>
          <line x1="10" y1="1" x2="10" y2="4"/>
          <line x1="14" y1="1" x2="14" y2="4"/>
        </svg>
      </div>
    </div>

    <!-- User Profile -->
    <div class="sidebar-user">
      <div class="sidebar-user__avatar">
        <%= Current.professional.name&.first&.upcase || "U" %>
      </div>
      <div class="sidebar-user__info">
        <div class="sidebar-user__name"><%= Current.professional.name || "User" %></div>
        <div class="sidebar-user__email"><%= Current.professional.email || "user@example.com" %></div>
      </div>
      <svg class="sidebar-user__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="app-layout__main">
    <div class="app-layout__content">
      <!-- Top Bar -->
      <div class="top-bar">
        <span class="top-bar__badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          All changes saved
        </span>
        <%= link_to "#", class: "top-bar__button" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          Need help?
        <% end %>
        <button type="button" class="top-bar__theme-btn" aria-label="Toggle theme">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </button>
      </div>

      <!-- Hero Section -->
      <section class="hero">
        <div class="hero__annotation">
          <span>Let's make this <em>perfect.</em></span>
          <svg class="hero__annotation-arrow" viewBox="0 0 40 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 2 Q 15 18, 35 12" fill="none"/>
            <polyline points="30 8 35 12 32 17"/>
          </svg>
        </div>

        <div class="hero__heading-wrapper">
          <h1 class="hero__heading">
            ADAPT YOUR CV<span class="hero__heading-dot">.</span>
          </h1>
          <div class="hero__pitch-bubble">
            Our AI writes<br>the pitch.<br>You land the<br><em>interview.</em>
          </div>
        </div>

        <p class="hero__subheading">
          Tell us about the opportunity and we'll write the perfect pitch by merging your Career Profile with the job blueprint.
        </p>
      </section>

      <!-- Form -->
      <%= form_with model: @opportunity, class: "stack", data: { controller: "opportunity-form" } do |f| %>
        <% if @opportunity.errors.any? %>
          <div class="form-errors">
            <ul>
              <% @opportunity.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-grid">
          <!-- Company Card -->
          <div class="form-card">
            <div class="form-card__header">
              <svg class="form-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
                <line x1="12" y1="6" x2="12.01" y2="6"/>
                <line x1="12" y1="10" x2="12.01" y2="10"/>
                <line x1="12" y1="14" x2="12.01" y2="14"/>
                <line x1="12" y1="18" x2="12.01" y2="18"/>
                <line x1="8" y1="6" x2="8.01" y2="6"/>
                <line x1="8" y1="10" x2="8.01" y2="10"/>
                <line x1="8" y1="14" x2="8.01" y2="14"/>
                <line x1="8" y1="18" x2="8.01" y2="18"/>
                <line x1="16" y1="6" x2="16.01" y2="6"/>
                <line x1="16" y1="10" x2="16.01" y2="10"/>
                <line x1="16" y1="14" x2="16.01" y2="14"/>
                <line x1="16" y1="18" x2="16.01" y2="18"/>
              </svg>
              <div class="form-card__title-group">
                <div class="form-card__title">1. Company</div>
                <div class="form-card__subtitle">Who are you applying to?</div>
              </div>
            </div>
            <%= f.text_field :organization_name, required: true, class: "home-input", placeholder: "e.g. Linear, Notion, Airbnb" %>
            <div class="form-hint">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17l9.2-9.2M17 17V7H7"/>
              </svg>
              <span>Add the company name to help us tailor the pitch and tone.</span>
            </div>
          </div>

          <!-- Job Description Card -->
          <div class="form-card">
            <div class="form-card__header">
              <svg class="form-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
              <div class="form-card__title-group">
                <div class="form-card__title">2. Job Description</div>
                <div class="form-card__subtitle">Paste the full job description.</div>
              </div>
            </div>
            <%= f.text_area :posting, required: true, class: "home-input home-textarea", placeholder: "Paste the job description here...", data: { opportunity_form_target: "textarea", action: "input->opportunity-form#updateCounter" } %>
            <div class="textarea-actions">
              <button type="button" class="textarea-actions__btn" data-action="click->opportunity-form#pasteFromClipboard">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                  <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
                </svg>
                Paste from clipboard
              </button>
              <span class="textarea-actions__count" data-opportunity-form-target="counter">0 characters</span>
            </div>
          </div>

          <!-- Tone Card -->
          <div class="form-card">
            <div class="form-card__header">
              <svg class="form-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
              <div class="form-card__title-group">
                <div class="form-card__title">3. Tone (Optional)</div>
                <div class="form-card__subtitle">How should we sound?</div>
              </div>
            </div>
            <select class="home-select" name="opportunity[tone]">
              <option value="professional">Professional & Confident (Default)</option>
              <option value="friendly">Friendly & Approachable</option>
              <option value="bold">Bold & Assertive</option>
              <option value="creative">Creative & Innovative</option>
            </select>
          </div>

          <!-- What Happens Next Card -->
          <div class="form-card">
            <div class="info-box">
              <svg class="info-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
              <div class="info-box__content">
                <div class="info-box__title">What happens next?</div>
                <div class="info-box__text">
                  Our Adapt Engine will intelligently merge your Career Profile with this job blueprint to craft a highly targeted resume. You'll get a polished PDF, ready to send.
                </div>
              </div>
              <div class="info-box__illustration">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- CTA Button -->
        <%= button_tag type: :submit, class: "cta-button" do %>
          <span class="cta-button__sparkles">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
            </svg>
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
            </svg>
          </span>
          ADAPT & GENERATE PDF
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        <% end %>

        <!-- Privacy Note -->
        <div class="privacy-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Your data is private and never shared.
        </div>
      <% end %>
    </div>
  </main>
</div>
