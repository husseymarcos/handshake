<% content_for :title, "Log In — Handshake" %>

<div class="login-page">
  <div class="login-card">
    <h1 class="login-title">Handshake.</h1>

    <%= form_with url: session_path, scope: :session, class: "login-form" do |f| %>
      <div class="login-field">
        <%= f.email_field :email, 
          required: true, 
          autocomplete: "username", 
          placeholder: "Email address",
          class: "login-input" %>
      </div>
      
      <div class="login-field">
        <%= f.password_field :password, 
          required: true, 
          autocomplete: "current-password", 
          placeholder: "Password",
          class: "login-input" %>
      </div>
      
      <%= f.submit "Log In", class: "login-button" %>
    <% end %>

    <div class="login-footer">
      <%= link_to "Need an account? Sign up.", signup_path, class: "login-link" %>
    </div>
  </div>
</div>
