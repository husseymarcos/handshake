<% content_for :title, "Log In — Handshake" %>

<div class="auth-page">
  <%= render "shared/auth/pitch" %>

  <section class="auth-panel" aria-labelledby="signin-title">
    <div class="auth-card">
      <header class="auth-card__header">
        <h2 id="signin-title" class="title title--auth">Welcome back<span class="title__accent">.</span></h2>
        <p>Log in to continue building your career.</p>
      </header>

      <%= render "form" %>
    </div>

    <p class="auth-switch">
      New to Handshake?
      <%= link_to signup_path do %>
        Create your account
        <span aria-hidden="true">&rarr;</span>
      <% end %>
    </p>
  </section>
</div>
