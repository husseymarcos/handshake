<%= form_with url: session_path, scope: :session, class: "auth-form" do |f| %>
  <div class="auth-field">
    <%= f.label :email, "Email address", class: "auth-field__label" %>
    <div class="auth-field__control">
      <svg class="auth-field__icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"/>
        <path d="m4 7 8 6 8-6"/>
      </svg>
      <%= f.email_field :email,
        required: true,
        autocomplete: "username",
        placeholder: "you@example.com",
        class: "auth-input" %>
    </div>
  </div>

  <div class="auth-field">
    <div class="auth-field__header">
      <%= f.label :password, "Password", class: "auth-field__label" %>
      <%= link_to "Forgot password?", "#", class: "link link--small" %>
    </div>
    <div class="auth-field__control">
      <svg class="auth-field__icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="5" y="10" width="14" height="10" rx="2"/>
        <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        <path d="M12 14v2"/>
      </svg>
      <%= f.password_field :password,
        required: true,
        autocomplete: "current-password",
        placeholder: "••••••••",
        class: "auth-input" %>
    </div>
  </div>

  <label class="auth-choice">
    <%= f.check_box :remember_me %>
    <span>Remember me</span>
  </label>

  <%= f.submit "Log in", class: "btn btn--primary btn--block" %>
<% end %>
