<%= form_with url: session_path, scope: :session, class: "auth-form" do |f| %>
  <%= render "shared/auth/field",
    form: f,
    attribute: :email,
    label: "Email address",
    field: :email_field,
    icon: :email,
    options: { required: true, autocomplete: "username", placeholder: "you@example.com", class: "auth-input" } %>

  <%= render "shared/auth/field",
    form: f,
    attribute: :password,
    label: "Password",
    field: :password_field,
    icon: :lock,
    header: link_to("Forgot password?", "#", class: "link link--small"),
    options: { required: true, autocomplete: "current-password", placeholder: "••••••••", class: "auth-input" } %>

  <label class="auth-choice">
    <%= f.check_box :remember_me %>
    <span>Remember me</span>
  </label>

  <%= f.submit "Log in", class: "btn btn--primary btn--block" %>
<% end %>
