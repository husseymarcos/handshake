<% content_for :title, "Sign Up — Handshake" %>

<div class="login-page">
  <div class="login-card">
    <h1 class="login-title">Handshake.</h1>

    <%= form_with model: @user, class: "login-form" do |f| %>
      <% if @user.errors.any? %>
        <div class="form-errors">
          <%= pluralize(@user.errors.count, "issue") %> to fix:
          <ul>
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      
      <div class="login-field">
        <%= f.email_field :email, 
          required: true, 
          autocomplete: "email", 
          placeholder: "Email address",
          class: "login-input" %>
      </div>
      
      <div class="login-field">
        <%= f.password_field :password, 
          required: true, 
          autocomplete: "new-password", 
          placeholder: "Password",
          class: "login-input" %>
      </div>
      
      <div class="login-field">
        <%= f.password_field :password_confirmation, 
          required: true, 
          autocomplete: "new-password", 
          placeholder: "Confirm password",
          class: "login-input" %>
      </div>
      
      <%= f.submit "Sign Up", class: "login-button" %>
    <% end %>

    <div class="login-footer">
      <%= link_to "Have an account? Log in.", signin_path, class: "login-link" %>
    </div>
  </div>
</div>
