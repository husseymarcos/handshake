<% content_for :title, "Library — Handshake" %>

<div class="page-header">
  <h1 class="display">Your library</h1>
  <p class="lede">Skills, projects, and the Typst blueprint used for every tailored resume.</p>
  <%= link_to "Edit blueprint", edit_user_path(@user), class: "pill" %>
</div>

<section class="card stack">
  <h2 class="section-title">Skills</h2>
  <%= form_with model: Skill.new, url: skills_path, class: "row" do |f| %>
    <%= f.text_field :name, placeholder: "e.g. Ruby on Rails", class: "input input--massive flex-grow" %>
    <%= f.submit "Add", class: "pill pill--accent" %>
  <% end %>
  <% if @user.skills.any? %>
    <ul class="pills-list">
      <% @user.skills.alphabetically.each do |skill| %>
        <li>
          <span class="pill pill--tag"><%= skill.name %></span>
          <%= button_to "Remove", skill_path(skill), method: :delete, class: "link-button", form: { data: { turbo_confirm: "Remove this skill?" } } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">No skills yet — add a few you want emphasized on resumes.</p>
  <% end %>
</section>

<section class="card stack">
  <div class="row row--between">
    <h2 class="section-title">Projects</h2>
    <%= link_to "Add project", new_project_path, class: "pill pill--accent" %>
  </div>
  <% if @user.projects.any? %>
    <ul class="project-list">
      <% @user.projects.chronologically.each do |project| %>
        <li class="project-list__item">
          <div>
            <strong><%= project.name %></strong>
            <% if project.year.present? %><span class="muted"> · <%= project.year %></span><% end %>
            <% if project.title.present? %><div class="muted"><%= project.title %></div><% end %>
          </div>
          <div class="row">
            <%= link_to "Edit", edit_project_path(project), class: "link" %>
            <%= button_to "Delete", project_path(project), method: :delete, class: "link-button", form: { data: { turbo_confirm: "Delete this project?" } } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">Add projects so the model can cite real work.</p>
  <% end %>
</section>
