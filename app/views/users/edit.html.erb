<% content_for :title, "Profile — Handshake" %>

<div class="page-header">
  <h1 class="display">Profile</h1>
  <p class="lede">Update your account settings.</p>
</div>

<div class="card">
  <%= form_with model: @user, class: "stack" do |f| %>
    <% if @user.errors.any? %>
      <div class="form-errors">
        <ul>
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <label class="field">
      <span class="field__label">Email</span>
      <%= f.email_field :email, class: "input" %>
    </label>
    <%= f.submit "Save changes", class: "pill pill--accent" %>
  <% end %>
</div>
