<% content_for :title, "Sign Up — Handshake" %>

<div class="auth-page">
  <%= render "shared/auth/pitch" %>

  <section class="auth-panel" aria-labelledby="signup-title">
    <div class="auth-card">
      <header class="auth-card__header">
        <h2 id="signup-title" class="title title--auth">Create account<span class="title__accent">.</span></h2>
        <p>Start tailoring resumes for every opportunity.</p>
      </header>

      <%= render "registration_form", professional: @professional %>

      <p class="auth-switch">
        Already have an account?
        <%= link_to signin_path do %>
          Log in
          <span aria-hidden="true">&rarr;</span>
        <% end %>
      </p>
    </div>
  </section>
</div>
