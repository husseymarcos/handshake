<%= form_with model: professional, class: "auth-form" do |f| %>
  <% if professional.errors.any? %>
    <div class="form-errors">
      <%= pluralize(professional.errors.count, "issue") %> to fix:
      <ul>
        <% professional.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="auth-field">
    <%= f.label :name, "Full name", class: "auth-label" %>
    <div class="auth-input-wrap">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="8" r="4"/>
        <path d="M4 21a8 8 0 0 1 16 0"/>
      </svg>
      <%= f.text_field :name,
        required: true,
        autocomplete: "name",
        placeholder: "Your name",
        class: "auth-input" %>
    </div>
  </div>

  <div class="auth-field">
    <%= f.label :email, "Email address", class: "auth-label" %>
    <div class="auth-input-wrap">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"/>
        <path d="m4 7 8 6 8-6"/>
      </svg>
      <%= f.email_field :email,
        required: true,
        autocomplete: "email",
        placeholder: "you@example.com",
        class: "auth-input" %>
    </div>
  </div>

  <div class="auth-field">
    <%= f.label :password, "Password", class: "auth-label" %>
    <div class="auth-input-wrap">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="5" y="10" width="14" height="10" rx="2"/>
        <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        <path d="M12 14v2"/>
      </svg>
      <%= f.password_field :password,
        required: true,
        autocomplete: "new-password",
        placeholder: "••••••••",
        class: "auth-input" %>
    </div>
  </div>

  <div class="auth-field">
    <%= f.label :password_confirmation, "Confirm password", class: "auth-label" %>
    <div class="auth-input-wrap">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"/>
        <path d="M5 20h14"/>
      </svg>
      <%= f.password_field :password_confirmation,
        required: true,
        autocomplete: "new-password",
        placeholder: "••••••••",
        class: "auth-input" %>
    </div>
  </div>

  <%= f.submit "Create account", class: "button button--primary auth-button" %>
<% end %>
