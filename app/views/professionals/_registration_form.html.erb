<%= form_with model: professional, class: "auth-form" do |f| %>
  <%= render "professionals/errors",
    professional: professional,
    summary: "#{pluralize(professional.errors.count, "issue")} to fix:",
    list_class: "error-list--offset" %>

  <%= render "shared/auth/field",
    form: f,
    attribute: :name,
    label: "Full name",
    field: :text_field,
    icon: :person,
    options: { required: true, autocomplete: "name", placeholder: "Your name", class: "auth-input" } %>

  <%= render "shared/auth/field",
    form: f,
    attribute: :email,
    label: "Email address",
    field: :email_field,
    icon: :email,
    options: { required: true, autocomplete: "email", placeholder: "you@example.com", class: "auth-input" } %>

  <%= render "shared/auth/field",
    form: f,
    attribute: :password,
    label: "Password",
    field: :password_field,
    icon: :lock,
    options: { required: true, autocomplete: "new-password", placeholder: "••••••••", class: "auth-input" } %>

  <%= render "shared/auth/field",
    form: f,
    attribute: :password_confirmation,
    label: "Confirm password",
    field: :password_field,
    icon: :check,
    options: { required: true, autocomplete: "new-password", placeholder: "••••••••", class: "auth-input" } %>

  <%= f.submit "Create account", class: "btn btn--primary btn--block" %>
<% end %>
