<% content_for :title, "Profile — Handshake" %>

<div class="page-header">
  <h1 class="display title--compact">Profile</h1>
  <p class="lede">Update your account settings.</p>
</div>

<div class="card">
  <%= form_with model: @professional, class: "form-stack" do |f| %>
    <% if @professional.errors.any? %>
      <div class="error-panel" role="alert">
        <ul class="error-list">
          <% @professional.errors.full_messages.each do |msg| %>
            <li class="error-list__item"><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <label class="field">
      <span class="field__label">Name</span>
      <%= f.text_field :name, class: "input input--plain" %>
    </label>
    <label class="field">
      <span class="field__label">Email</span>
      <%= f.email_field :email, class: "input input--plain" %>
    </label>
    <%= f.submit "Save changes", class: "pill pill--accent btn--fit" %>
  <% end %>
</div>
