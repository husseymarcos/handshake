<% content_for :title, "Resume history — Handshake" %>

<div class="page-header row row--between">
  <div>
    <h1 class="display">Resume history</h1>
    <p class="lede">Newest applications first.</p>
  </div>
  <%= link_to "New resume", new_job_application_path, class: "pill pill--accent" %>
</div>

<% if @job_applications.any? %>
  <ul class="card list-plain stack">
    <% @job_applications.each do |app| %>
      <li class="history-row">
        <div>
          <%= link_to app.company_name, job_application_path(app), class: "history-row__title" %>
          <div class="muted"><%= l app.created_at, format: :long %></div>
        </div>
        <% if app.pdf.attached? %>
          <%= link_to "PDF", job_application_download_path(app), class: "pill" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="card">
    <p class="lede">No resumes yet.</p>
    <%= link_to "Generate your first", new_job_application_path, class: "pill pill--accent" %>
  </div>
<% end %>
