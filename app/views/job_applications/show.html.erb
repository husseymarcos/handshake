<% content_for :title, "#{@job_application.company_name} — Handshake" %>

<div class="page-header row row--between">
  <div>
    <h1 class="display"><%= @job_application.company_name %></h1>
    <p class="muted">Generated <%= l @job_application.created_at, format: :long %></p>
    <% if @job_application.job_description_truncated? %>
      <p class="flash flash--warning">The job description was shortened to the token limit.</p>
    <% end %>
  </div>
  <% if @job_application.pdf.attached? %>
    <%= link_to "Download PDF", job_application_download_path(@job_application), class: "pill pill--accent" %>
  <% end %>
</div>

<section class="card stack">
  <h2 class="section-title">Job description used</h2>
  <pre class="job-preview"><%= @job_application.job_description %></pre>
</section>

<% if @job_application.generated_typst.present? %>
  <section class="card stack">
    <h2 class="section-title">Generated Typst</h2>
    <pre class="code-preview"><%= @job_application.generated_typst %></pre>
  </section>
<% end %>

<p><%= link_to "← History", job_applications_path, class: "link" %></p>
