<div class="account-card">
  <%= link_to settings_path, class: "account-card__identity", aria: { label: "Open settings" } do %>
    <div class="account-card__avatar">
      <%= (Current.professional.name || "U").first.upcase %>
    </div>
    <div class="account-card__details">
      <div class="account-card__name truncate"><%= Current.professional.name || "User" %></div>
      <div class="account-card__email truncate"><%= Current.professional.email || "user@example.com" %></div>
    </div>
  <% end %>

  <details class="account-menu">
    <summary class="account-menu__summary" aria-label="Account menu">
      <svg class="account-menu__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </summary>
    <div class="account-menu__panel">
      <%= button_to "Log out", session_path, method: :delete, class: "btn btn--menu" %>
    </div>
  </details>
</div>
