<section class="auth-pitch" aria-label="Handshake">
  <div class="auth-brand">
    <%= image_tag "/logo.png", alt: "Handshake", class: "auth-brand__logo" %>
  </div>

  <div class="auth-pitch__copy">
    <div class="auth-spark auth-spark--top" aria-hidden="true">&#10022;</div>
    <h1 class="title--hero">Perfect resumes.<br>In one click<span class="title__accent">.</span></h1>
    <p>Write once. Apply everywhere.<br>Land more interviews.</p>
  </div>

  <div class="auth-sketches" aria-hidden="true">
    <div class="auth-spark auth-spark--left">&#10022;</div>
    <%= image_tag "/writeonce.png", alt: "", class: "auth-sketches__note" %>
    <%= image_tag "/mug.png", alt: "", class: "auth-sketches__mug" %>
  </div>
</section>
